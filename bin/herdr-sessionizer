#!/usr/bin/env bash
# herdr-sessionizer — tmux-sessionizer, but for Herdr.
# Fuzzy-pick a project directory, then focus the workspace whose label
# matches it, or create a new workspace rooted there.
#
# Runs inside a Herdr popup (ctrl+f). Herdr provides HERDR_ENV and
# HERDR_BIN_PATH in popup/pane environments.

set -euo pipefail

if [[ "${HERDR_ENV:-}" != "1" ]]; then
  echo "herdr-sessionizer: not inside a Herdr session" >&2
  exit 1
fi

herdr_bin="${HERDR_BIN_PATH:-herdr}"

# Project roots to scan. Add more paths here as needed.
search_dirs=(
  "$HOME/repos"
  "$HOME/repos/gm"
)

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  # Keep only search dirs that actually exist; find fails on missing paths
  # and (with pipefail) would poison the pipeline status.
  existing_dirs=()
  for dir in "${search_dirs[@]}"; do
    [[ -d "$dir" ]] && existing_dirs+=("$dir")
  done
  if [[ ${#existing_dirs[@]} -eq 0 ]]; then
    echo "herdr-sessionizer: no search directories exist" >&2
    exit 1
  fi
  selected=$(
    find "${existing_dirs[@]}" -mindepth 1 -maxdepth 1 -type d \
      -not -name '.*' 2>/dev/null |
      sort -u |
      while IFS= read -r line; do printf '%s\n' "${line#"$HOME/"}"; done |
      fzf --prompt='workspace> ' --height=100% --reverse
  ) || exit 0
  selected="$HOME/$selected"
fi

[[ -d "$selected" ]] || { echo "not a directory: $selected" >&2; exit 1; }

# Workspace label = directory basename, dots -> underscores (tmux-sessionizer style).
label=$(basename "$selected" | tr '.' '_')

# Focus the workspace if one with this label already exists.
existing=$(
  "$herdr_bin" workspace list |
    jq -r --arg label "$label" \
      '.result.workspaces[] | select(.label == $label) | .workspace_id' |
    head -n1
)

if [[ -n "$existing" ]]; then
  "$herdr_bin" workspace focus "$existing"
else
  "$herdr_bin" workspace create --cwd "$selected" --label "$label" --focus
fi
