    "delegation",
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoosex/pi-subagent.git"
  },
  "homepage": "https://github.com/smoosex/pi-subagent",
